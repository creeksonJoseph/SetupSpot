# ==============================================================================
# SetupSpot Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# ── PostgreSQL Database (NeonDB / Local Postgres with pgvector) ───────────────
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Cloudinary (Image uploads & media management) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=SetupSpot

# ── JWT Authentication & Security ─────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=https://setupspot.tech

# ── Sentry Error Monitoring & Performance Profiling ───────────────────────────
# Sentry DSN for crash reporting, APM tracing, and profiling.
# Leave unset or empty in local development to keep Sentry inactive without errors.
SENTRY_DSN=https://450f2ab183fcbd70222b4d82ac5d59a2@o4512254075535360.ingest.de.sentry.io/4512254344822864
ENVIRONMENT=development

# ── Resend (Transactional Email & OTP) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Google OAuth 2.0 (Google One-Tap & Sign-In) ───────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://setupspot.tech/auth/callback

# ── Algolia Instant Search ────────────────────────────────────────────────────
ALGOLIA_APP_ID=82D9UQ8ZF3
ALGOLIA_WRITE_API_KEY=your_algolia_write_api_key
ALGOLIA_INDEX_NAME=setups

# ── Upstash Redis (Caching, Rate Limiting & Session Revocation) ───────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
